rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function me() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function admin() { return signedIn() && me().role == 'admin'; }
    function school() { return signedIn() && me().role == 'school' && me().schoolApproved == true; }
    function connected(sid) {
      return signedIn() && ((school() && request.auth.uid == sid)
        || (me().role in ['student','teacher'] && me().get('schoolId','') == sid
          && me().get('schoolJoinStatus','') == 'connected'));
    }
    function teacher(sid) { return connected(sid) && (school() || me().role == 'teacher'); }
    function ownsConversation(id) {
      let c = get(/databases/$(database)/documents/conversations/$(id)).data;
      return signedIn() && request.auth.uid in c.members && connected(c.schoolId);
    }
    match /users/{uid} {
      allow create: if signedIn() && uid == request.auth.uid
        && request.resource.data.uid == uid
        && request.resource.data.role in ['student','school','teacher']
        && request.resource.data.schoolApproved == (request.resource.data.role != 'school')
        && request.resource.data.keys().hasOnly(['uid','name','email','role','schoolName','className','contactNumber','address','schoolApproved','createdAt']);
      allow read: if signedIn() && (uid == request.auth.uid || admin()
        || (school() && request.auth.uid == resource.data.get('schoolId','')));
      allow update: if admin() || (signedIn() && uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','className','phone','dateOfBirth','gender','profileUpdatedAt','profilePhotoUrl','fcmToken','fcmTokenUpdatedAt'])
        && request.resource.data.name is string && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 200
        && (!('profilePhotoUrl' in request.resource.data) || request.resource.data.profilePhotoUrl.matches('https://firebasestorage.googleapis.com/.*')));
    }
    match /schoolCodes/{code} { allow get: if signedIn(); allow list,write: if admin(); }
    match /schoolJoinRequests/{id} { allow read: if signedIn() && (admin() || resource.data.studentId == request.auth.uid || (school() && resource.data.schoolId == request.auth.uid)); }
    match /results/{id} { allow read,delete: if signedIn() && (resource.data.userId == request.auth.uid || admin()); }
    match /schoolResults/{id} { allow read: if signedIn() && (resource.data.studentId == request.auth.uid || teacher(resource.data.schoolId) || admin()); allow delete: if teacher(resource.data.schoolId) || admin(); }
    match /attendance/{id} { allow read: if signedIn() && (resource.data.studentId == request.auth.uid || teacher(resource.data.schoolId) || admin()); }
    match /notices/{id} { allow read: if connected(resource.data.schoolId) || admin(); allow delete: if teacher(resource.data.schoolId) || admin(); }
    // Student clients receive sanitized questions only through callable endpoints.
    match /mcqTests/{id} { allow read: if teacher(resource.data.schoolId) || admin(); }
    match /mcqKeys/{id} { allow read: if teacher(resource.data.schoolId) || admin(); }
    match /mcqAttempts/{id} { allow read: if signedIn() && (resource.data.studentId == request.auth.uid || teacher(resource.data.schoolId) || admin()); }
    match /marksheetVerifications/{id} { allow read: if signedIn() && (resource.data.issuerUid == request.auth.uid || admin()); }
    match /conversations/{id} {
      allow read: if signedIn() && request.auth.uid in resource.data.members && connected(resource.data.schoolId);
      match /messages/{messageId} { allow read: if ownsConversation(id); }
    }
    match /coupons/{id} { allow get: if signedIn(); allow list,write: if admin(); }
    match /plans/{id} { allow read: if signedIn(); allow write: if admin(); }
    match /proOrders/{id} { allow read: if signedIn() && (resource.data.uid == request.auth.uid || admin()); }
    match /couponRedemptions/{id} { allow read: if signedIn() && (resource.data.uid == request.auth.uid || admin()); }
    match /membershipAudit/{id} { allow read: if admin(); }
    match /{document=**} { allow read,write: if false; }
  }
}
