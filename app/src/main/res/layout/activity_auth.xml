<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#F5F7FC">
 <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
   <LinearLayout android:layout_width="match_parent" android:layout_height="230dp" android:orientation="vertical" android:gravity="center" android:padding="24dp" android:background="@drawable/bg_auth_gradient">
    <TextView android:layout_width="68dp" android:layout_height="68dp" android:gravity="center" android:text="E" android:textColor="#3157D5" android:textSize="32sp" android:textStyle="bold" android:background="@drawable/bg_auth_card"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="EduNexa" android:textColor="#FFFFFF" android:textSize="32sp" android:textStyle="bold"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Learn • Calculate • Create • Connect • Grow" android:textColor="#EEEAFE" android:textSize="13sp"/>
   </LinearLayout>
   <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="18dp" android:layout_marginTop="-24dp" android:orientation="vertical" android:padding="22dp" android:elevation="8dp" android:background="@drawable/bg_auth_card">
    <LinearLayout android:id="@+id/welcomePanel" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
     <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Welcome to EduNexa" android:textColor="#17213D" android:textSize="25sp" android:textStyle="bold"/>
     <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:layout_marginBottom="22dp" android:text="Choose how you want to continue" android:textColor="#72798F" android:textSize="14sp"/>
     <Button android:id="@+id/studentChoiceBtn" android:layout_width="match_parent" android:layout_height="64dp" android:text="🎓  I’m a Student" android:textAllCaps="false" android:textColor="#FFFFFF" android:textSize="17sp" android:textStyle="bold" android:background="@drawable/bg_auth_button"/>
     <Button android:id="@+id/schoolChoiceBtn" android:layout_width="match_parent" android:layout_height="64dp" android:layout_marginTop="12dp" android:text="🏫  I’m a School" android:textAllCaps="false" android:textColor="#3157D5" android:textSize="17sp" android:textStyle="bold" android:background="@drawable/bg_auth_input"/>
     <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:gravity="center" android:text="Already registered?" android:textColor="#7A8092" android:textSize="13sp"/>
     <Button android:id="@+id/showLoginBtn" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="6dp" android:text="Login to EduNexa" android:textAllCaps="false" android:textColor="#3157D5" android:textSize="16sp" android:textStyle="bold" android:background="@drawable/bg_auth_input"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/formPanel" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
     <TextView android:id="@+id/formTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Create Student Account" android:textColor="#17213D" android:textSize="25sp" android:textStyle="bold"/>
     <TextView android:id="@+id/formSubtitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:layout_marginBottom="18dp" android:text="Start your EduNexa journey" android:textColor="#72798F" android:textSize="14sp"/>
     <EditText android:id="@+id/nameInput" android:layout_width="match_parent" android:layout_height="56dp" android:hint="Full name" android:singleLine="true" android:textColor="#17213D" android:textColorHint="#9096A8" android:background="@drawable/bg_auth_input"/>
     <EditText android:id="@+id/emailInput" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="12dp" android:hint="Email address" android:inputType="textEmailAddress" android:singleLine="true" android:textColor="#17213D" android:textColorHint="#9096A8" android:background="@drawable/bg_auth_input"/>
     <EditText android:id="@+id/passwordInput" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="12dp" android:hint="Password (minimum 6 characters)" android:inputType="textPassword" android:singleLine="true" android:textColor="#17213D" android:textColorHint="#9096A8" android:background="@drawable/bg_auth_input"/>
     <EditText android:id="@+id/schoolInput" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="12dp" android:hint="School name" android:singleLine="true" android:textColor="#17213D" android:textColorHint="#9096A8" android:background="@drawable/bg_auth_input" android:visibility="gone"/>
     <Spinner android:id="@+id/roleSpinner" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone"/>
     <Button android:id="@+id/registerBtn" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="20dp" android:text="Create Account" android:textAllCaps="false" android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold" android:background="@drawable/bg_auth_button"/>
     <Button android:id="@+id/loginBtn" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="20dp" android:text="Login" android:textAllCaps="false" android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold" android:background="@drawable/bg_auth_button" android:visibility="gone"/>
     <Button android:id="@+id/backBtn" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="10dp" android:text="← Back" android:textAllCaps="false" android:textColor="#3157D5" android:background="@android:color/transparent"/>
     <ProgressBar android:id="@+id/progress" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:layout_marginTop="10dp" android:visibility="gone"/>
     <TextView android:id="@+id/statusText" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:paddingTop="10dp" android:textColor="#D23B4A" android:textSize="13sp"/>
    </LinearLayout>
   </LinearLayout>
  </LinearLayout>
 </ScrollView>
</FrameLayout>