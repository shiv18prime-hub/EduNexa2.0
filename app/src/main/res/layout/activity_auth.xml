<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="#F5F7FC">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
  <LinearLayout android:layout_width="match_parent" android:layout_height="240dp" android:orientation="vertical" android:gravity="center" android:padding="24dp" android:background="@drawable/bg_auth_gradient">
   <TextView android:layout_width="72dp" android:layout_height="72dp" android:gravity="center" android:text="E" android:textColor="#3157D5" android:textSize="34sp" android:textStyle="bold" android:background="@drawable/bg_auth_card" />
   <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="EduNexa" android:textColor="#FFFFFF" android:textSize="34sp" android:textStyle="bold" />
   <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Learn • Calculate • Create • Connect • Grow" android:textColor="#EEEAFE" android:textSize="14sp" />
  </LinearLayout>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginLeft="18dp" android:layout_marginRight="18dp" android:layout_marginTop="-28dp" android:layout_marginBottom="24dp" android:orientation="vertical" android:padding="22dp" android:elevation="8dp" android:background="@drawable/bg_auth_card">
   <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Welcome 👋" android:textColor="#17213D" android:textSize="26sp" android:textStyle="bold" />
   <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:layout_marginBottom="18dp" android:text="Create your Student or School account" android:textColor="#72798F" android:textSize="14sp" />
   <EditText android:id="@+id/nameInput" android:layout_width="match_parent" android:layout_height="56dp" android:hint="Full name" android:textColor="#17213D" android:textColorHint="#9096A8" android:singleLine="true" android:background="@drawable/bg_auth_input" />
   <EditText android:id="@+id/emailInput" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="12dp" android:hint="Email address" android:inputType="textEmailAddress" android:textColor="#17213D" android:textColorHint="#9096A8" android:singleLine="true" android:background="@drawable/bg_auth_input" />
   <EditText android:id="@+id/passwordInput" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="12dp" android:hint="Password" android:inputType="textPassword" android:textColor="#17213D" android:textColorHint="#9096A8" android:singleLine="true" android:background="@drawable/bg_auth_input" />
   <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:layout_marginBottom="6dp" android:text="Account type" android:textColor="#414960" android:textSize="13sp" android:textStyle="bold" />
   <Spinner android:id="@+id/roleSpinner" android:layout_width="match_parent" android:layout_height="56dp" android:paddingLeft="12dp" android:paddingRight="12dp" android:background="@drawable/bg_auth_input" />
   <EditText android:id="@+id/schoolInput" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="12dp" android:hint="School name (School account only)" android:textColor="#17213D" android:textColorHint="#9096A8" android:singleLine="true" android:background="@drawable/bg_auth_input" />
   <Button android:id="@+id/registerBtn" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="20dp" android:text="Create Account" android:textAllCaps="false" android:textSize="16sp" android:textStyle="bold" android:textColor="#FFFFFF" android:background="@drawable/bg_auth_button" />
   <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:layout_marginBottom="8dp" android:gravity="center" android:text="Already have an account?" android:textColor="#7A8092" android:textSize="13sp" />
   <Button android:id="@+id/loginBtn" android:layout_width="match_parent" android:layout_height="54dp" android:text="Login" android:textAllCaps="false" android:textSize="16sp" android:textStyle="bold" android:textColor="#3157D5" android:background="@drawable/bg_auth_input" />
   <ProgressBar android:id="@+id/progress" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:layout_marginTop="14dp" android:visibility="gone" />
   <TextView android:id="@+id/statusText" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:paddingTop="12dp" android:textColor="#D23B4A" android:textSize="13sp" />
  </LinearLayout>
 </LinearLayout>
</ScrollView>
