<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="#F6F7FC">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp" android:background="@drawable/bg_premium_header">
  <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="EduNexa Admin" android:textSize="28sp" android:textStyle="bold" android:textColor="#FFFFFF" />
  <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Platform Control Center" android:textColor="#E8E5FF" />
 </LinearLayout>
 <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none" android:padding="12dp">
  <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
   <Button android:id="@+id/pendingTab" android:layout_width="wrap_content" android:layout_height="48dp" android:text="Pending Schools" android:textAllCaps="false" />
   <Button android:id="@+id/usersTab" android:layout_width="wrap_content" android:layout_height="48dp" android:layout_marginStart="8dp" android:text="Users" android:textAllCaps="false" />
   <Button android:id="@+id/couponsTab" android:layout_width="wrap_content" android:layout_height="48dp" android:layout_marginStart="8dp" android:text="Coupons" android:textAllCaps="false" />
   <Button android:id="@+id/proTab" android:layout_width="wrap_content" android:layout_height="48dp" android:layout_marginStart="8dp" android:text="Pro" android:textAllCaps="false" />
  </LinearLayout>
 </HorizontalScrollView>
 <ProgressBar android:id="@+id/adminProgress" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" />
 <TextView android:id="@+id/adminStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:padding="10dp" android:textColor="#5F667C" />
 <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
  <LinearLayout android:id="@+id/schoolList" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp" />
 </ScrollView>
</LinearLayout>
