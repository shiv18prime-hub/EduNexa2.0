<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="#F6F7FC">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp" android:background="@drawable/bg_premium_header">
  <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Connect School" android:textSize="27sp" android:textStyle="bold" android:textColor="#FFFFFF"/>
  <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Join your verified school securely" android:textColor="#E8E5FF"/>
 </LinearLayout>
 <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="20dp" android:elevation="4dp">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="22dp">
   <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Enter School Code" android:textSize="21sp" android:textStyle="bold" android:textColor="#292E4A"/>
   <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Ask your school for its EduNexa verification code." android:textColor="#6B7280"/>
   <EditText android:id="@+id/schoolCodeInput" android:layout_width="match_parent" android:layout_height="58dp" android:layout_marginTop="18dp" android:hint="EDU-123456" android:inputType="textCapCharacters" android:maxLength="10"/>
   <Button android:id="@+id/joinSchoolBtn" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="14dp" android:text="Connect School" android:textAllCaps="false"/>
   <ProgressBar android:id="@+id/joinProgress" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:layout_marginTop="12dp" android:visibility="gone"/>
   <TextView android:id="@+id/joinStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:padding="12dp" android:textColor="#5F667C"/>
  </LinearLayout>
 </com.google.android.material.card.MaterialCardView>
</LinearLayout>
