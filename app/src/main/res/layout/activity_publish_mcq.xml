<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#F6F7FC">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
  <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Create MCQ Test" android:textSize="28sp" android:textStyle="bold" android:textColor="#252A45"/>
  <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Publish a test for connected students" android:textColor="#667085"/>
  <EditText android:id="@+id/testTitleInput" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="18dp" android:hint="Test title"/>
  <EditText android:id="@+id/testSubjectInput" android:layout_width="match_parent" android:layout_height="56dp" android:hint="Subject"/>
  <EditText android:id="@+id/testChapterInput" android:layout_width="match_parent" android:layout_height="56dp" android:hint="Chapter"/>
  <EditText android:id="@+id/testDurationInput" android:layout_width="match_parent" android:layout_height="56dp" android:hint="Duration in minutes" android:inputType="number"/>
  <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="Question 1" android:textSize="19sp" android:textStyle="bold"/>
  <EditText android:id="@+id/questionInput" android:layout_width="match_parent" android:layout_height="56dp" android:hint="Question"/>
  <EditText android:id="@+id/optionAInput" android:layout_width="match_parent" android:layout_height="52dp" android:hint="Option A"/>
  <EditText android:id="@+id/optionBInput" android:layout_width="match_parent" android:layout_height="52dp" android:hint="Option B"/>
  <EditText android:id="@+id/optionCInput" android:layout_width="match_parent" android:layout_height="52dp" android:hint="Option C"/>
  <EditText android:id="@+id/optionDInput" android:layout_width="match_parent" android:layout_height="52dp" android:hint="Option D"/>
  <Spinner android:id="@+id/correctOptionSpinner" android:layout_width="match_parent" android:layout_height="56dp"/>
  <Button android:id="@+id/publishTestBtn" android:layout_width="match_parent" android:layout_height="58dp" android:layout_marginTop="16dp" android:text="Publish Test" android:textAllCaps="false"/>
  <ProgressBar android:id="@+id/testProgress" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:visibility="gone"/>
  <TextView android:id="@+id/testStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:padding="12dp" android:textColor="#5F667C"/>
 </LinearLayout>
</ScrollView>
